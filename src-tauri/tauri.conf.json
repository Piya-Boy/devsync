{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevSync",
  "version": "0.1.0",
  "identifier": "com.piyaboy.devsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && powershell -ExecutionPolicy Bypass -File scripts\\build-cli.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevSync",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {
      "bin/devsync.exe": "devsync.exe"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/Piya-Boy/devsync/releases/latest"
      ]
    }
  }
}
